{
  "name": "atlas-learning-platform-standalone",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed-academic": "node scripts/seed-academic.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:seed-academic",
    "test:schema": "node scripts/check-schema.mjs",
    "verify": "npm run test:schema && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.2",
    "next": "16.2.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.3"
  }
}